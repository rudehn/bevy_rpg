(
  spawns: [
    // ==================== VERMIN (Floors 1-6) ====================

    // Giant Rats — scaling packs
    (monster: "Giant Rat",     min_floor: 1,  max_floor: 3,  min_group: 1, max_group: 2),
    (monster: "Giant Rat",     min_floor: 4,  max_floor: 5,  min_group: 2, max_group: 3),
    (monster: "Giant Rat",     min_floor: 6,  max_floor: 8,  min_group: 3, max_group: 4),

    // Giant Bats — erratic scouts
    (monster: "Giant Bat",     min_floor: 1,  max_floor: 2,  min_group: 1, max_group: 1),
    (monster: "Giant Bat",     min_floor: 3,  max_floor: 4,  min_group: 1, max_group: 2),
    (monster: "Giant Bat",     min_floor: 5,  max_floor: 6,  min_group: 1, max_group: 3),

    // Wolves — pack hunters
    (monster: "Wolf",          min_floor: 3,  max_floor: 5,  min_group: 1, max_group: 2),
    (monster: "Wolf",          min_floor: 6,  max_floor: 8,  min_group: 2, max_group: 3),
    (monster: "Wolf",          min_floor: 9,  max_floor: 10, min_group: 3, max_group: 4),

    // Fire Salamanders — fire-damage dealers
    (monster: "Fire Salamander", min_floor: 3, max_floor: 5, min_group: 1, max_group: 1),
    (monster: "Fire Salamander", min_floor: 6, max_floor: 9, min_group: 1, max_group: 2),

    // Cave Bears — slow but powerful
    (monster: "Cave Bear",     min_floor: 6,  max_floor: 10, min_group: 1, max_group: 1),

    // Spiders — solo or pairs
    (monster: "Giant Spider",  min_floor: 3,  max_floor: 6,  min_group: 1, max_group: 2),

    // ==================== GOBLINS (Floors 2-8) ====================

    // Basic goblins — cowards that flee when hurt
    (monster: "Goblin",          min_floor: 1,  max_floor: 10, min_group: 1, max_group: 3),

    // Goblin archers — kiting ranged attackers
    (monster: "Goblin Archer",   min_floor: 2,  max_floor: 10, min_group: 1, max_group: 2),

    // Goblin brutes — armored melee
    (monster: "Goblin Brute",    min_floor: 5,  max_floor: 10, min_group: 1, max_group: 1),

    // Goblin shaman — solo
    (monster: "Goblin Shaman",   min_floor: 4,  max_floor: 7),

    // Goblin warchief — solo or with escort
    (monster: "Goblin Warchief", min_floor: 5,  max_floor: 8),

    // Goblin war party (mixed group)
    (group: [
        (monster: "Goblin Warchief", min_count: 1, max_count: 1),
        (monster: "Goblin",          min_count: 2, max_count: 3),
        (monster: "Goblin Archer",   min_count: 1, max_count: 2),
    ], min_floor: 5, max_floor: 8, on_leader_death: "scatter"),

    // ==================== ORCS (Floors 6-10) ====================

    // Orc warriors
    (monster: "Orc Warrior",     min_floor: 6,  max_floor: 10, min_group: 1, max_group: 3,
