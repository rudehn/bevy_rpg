// Monster spawn table for the linear-floor world (town → forest 1..4
// → temple at floor 5). Floor 5 (the temple) has no spawn entries —
// cultists will land in a future pass.
//
// Each entry tells `VoronoiSpawner` which monsters / packs are eligible
// on a given floor. The spawner picks one entry per chosen Voronoi cell
// at build time. See docs/design/SPAWNING.md for the algorithm and
// docs/design/ENEMIES.md for the per-monster identity / mechanic.
//
// **Difficulty curve:** Forest 1 is the introduction — solo encounters
// only (no packs at all) so new players learn one creature at a time.
// Starting on Forest 2, packs begin forming (rats/jackals pair up,
// wolves arrive as a 2-pack). Forest 3-4 are the full pack tier
// (3-rat swarms, 3-wolf packs) with rare Treants as deep-forest mini-
// bosses. The temple-entrance floor (Forest 4) is the densest.
//
// Schema reminder:
//   (monster: "Name", min_floor: i32, max_floor: i32, min_group: u32,
//    max_group: u32, flee_threshold: f32, spawn_on_liquid: bool, weight: u32)
//   (group: [(monster, min_count, max_count), ...], min_floor, max_floor, flee_threshold)
(
  spawns: [
    // ====================================================================
    // FOREST 1 — introductory, solo encounters only.
    // ====================================================================

    // Giant Rat solo: the floor-1 chump. One at a time so the player
    // learns the swarm threat without being overwhelmed.
    (monster: "Giant Rat", min_floor: 2, max_floor: 2, min_group: 1, max_group: 1),

    // Jackal solo: very fast skirmisher; teaches the player about
    // movement-delay threats before they meet wolves.
    (monster: "Jackal", min_floor: 2, max_floor: 2, min_group: 1, max_group: 1),

    // ====================================================================
    // FOREST 2 — packs begin forming.
    // ====================================================================

    // Giant Rats start pairing up.
    (monster: "Giant Rat", min_floor: 3, max_floor: 3, min_group: 1, max_group: 2),

    // Jackals hunt in pairs.
    (monster: "Jackal", min_floor: 3, max_floor: 3, min_group: 1, max_group: 2),

    // Wolves debut as a 2-pack — the first "real pack" encounter.
    // PackTactics rewards isolating them.
    (monster: "Wolf", min_floor: 3, max_floor: 3, min_group: 2, max_group: 2),

    // ====================================================================
    // FOREST 3-4 — full pack tier (deeper, denser woods).
    // ====================================================================

    // Giant Rat swarms (2-3 per pack).
    (monster: "Giant Rat", min_floor: 4, max_floor: 5, min_group: 2, max_group: 3),

    // Jackal pairs still common; sometimes a 3-pack.
    (monster: "Jackal", min_floor: 4, max_floor: 5, min_group: 1, max_group: 3),

    // Wolf packs — full 2-3 hunters, the staple deep-forest threat.
    (monster: "Wolf", min_floor: 4, max_floor: 5, min_group: 2, max_group: 3),

    // Treant: very rare deep-forest mini-boss. weight: 5 against the
    // default 100 means it spawns ~2.4% as often as a Giant Rat /
    // Jackal / Wolf entry on the same floor → most floors won't see
    // one; when one appears, it's a memorable encounter. Solo
    // (min_group=max_group=1). See assets/monsters.ron for the stat sheet.
    (monster: "Treant", min_floor: 3, max_floor: 5, min_group: 1, max_group: 1, weight: 5),
  ]
)

