    // Orc archers
    (monster: "Orc Archer",      min_floor: 7,  max_floor: 10, min_group: 1, max_group: 2),

    // Orc shaman — solo
    (monster: "Orc Shaman",      min_floor: 7,  max_floor: 10),

    // Orc warlord — solo
    (monster: "Orc Warlord",     min_floor: 8,  max_floor: 10),

    // Orc warband (mixed group)
    (group: [
        (monster: "Orc Warlord",  min_count: 1, max_count: 1),
        (monster: "Orc Warrior",  min_count: 2, max_count: 3),
        (monster: "Orc Archer",   min_count: 1, max_count: 2),
    ], min_floor: 8, max_floor: 10, on_leader_death: "scatter"),

    // ==================== FUNGAL (Floors 6-9) ====================

    // Spore Crawlers — groups (explode on death)
    (monster: "Spore Crawler",     min_floor: 6,  max_floor: 9, min_group: 2, max_group: 3),

