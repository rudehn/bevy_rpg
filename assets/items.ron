        )),
            rarity: Common,
            ascii_char: "}",
            ascii_fg: "#7A5A3A",
        ),
        // Mage's starter staff. Lightning effect at the standard 250-turn
        // recharge — the staff IS the Mage's primary weapon, not a once-
