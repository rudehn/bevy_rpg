        "Apprentice Staff": (
            name: "Apprentice Staff",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Staff((
            effect: Lightning,
            base_recharge: 250,
        )),
            rarity: Common,
            ascii_char: "/",
            ascii_fg: "#8888AA",
        ),
        // Cleave: lower base damage than the Sword, but the swing hits
        // every adjacent tile around the wielder — a circular AoE that
        // shines against grouped foes and risks friendly-overlap.
