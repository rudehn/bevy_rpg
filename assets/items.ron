        // ===========================
        // SHIELDS (3 tiers)
        // ===========================
        // Shields use a per-attack SH check (d20 + floor(Shields/4) + defense
        // vs DC 17). `defense` is the SH bonus, NOT a flat damage reduction.
        // `dodge_bonus` is the encumbrance penalty (negative). `max_blocks`
        // caps successful blocks per turn — once consumed, further hits
        // pass through until the entity's next turn.
        "Buckler": (
            name: "Buckler",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Armor((
            slot: OffHand,
            defense: 3,
            max_blocks: 1,
        )),
            dodge_bonus: -1,
            rarity: Common,
            ascii_char: ")",
            ascii_fg: "#B49664",
        ),
        "Kite Shield": (
            name: "Kite Shield",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Armor((
            slot: OffHand,
            defense: 8,
            max_blocks: 2,
        )),
            dodge_bonus: -3,
            rarity: Uncommon,
            ascii_char: ")",
            ascii_fg: "#A0A0A0",
        ),
        "Tower Shield": (
            name: "Tower Shield",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Armor((
            slot: OffHand,
            defense: 13,
            max_blocks: 3,
        )),
            dodge_bonus: -5,
            // Speed penalty: +10% delay on every action while equipped.
