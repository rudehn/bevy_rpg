(
    items: {
        // ===========================
        // WEAPONS (3 base templates)
        // ===========================
        "Dagger": (
            name: "Dagger",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Weapon((
            damage: "1d4",
            attack_speed: 0.5,
            weapon_ability: Some("Backstab"),
            weapon_skill: Some(ShortBlades),
        )),
            rarity: Common,
            ascii_char: "/",
            ascii_fg: "#A0A0A0",
        ),
        // The standard balance baseline. No active ability — the sword is
        // the reference weapon every other weapon is tuned against.
        "Sword": (
            name: "Sword",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Weapon((
            damage: "1d6",
            weapon_skill: Some(LongBlades),
        )),
            rarity: Common,
            ascii_char: "/",
            ascii_fg: "#A0A0A0",
        ),
        "Bow": (
            name: "Bow",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Weapon((
            damage: "1d4",
            weapon_range: 8,
            weapon_skill: Some(Ranged),
        )),
            rarity: Common,
            ascii_char: "}",
            ascii_fg: "#A0A0A0",
        ),
        // ---- Weak starter weapons (referenced by classes.ron starting_kit) ----
        // Warrior's starter: Sword without the d6 baseline. Same dice but
        // tinted rusty so it reads as "salvaged scrap, not legendary steel."
        "Rusted Shortsword": (
            name: "Rusted Shortsword",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Weapon((
            damage: "1d6",
            weapon_skill: Some(ShortBlades),
        )),
            rarity: Common,
            ascii_char: "/",
            ascii_fg: "#7A5A3A",
        ),
        // Rogue's emergency throwable. Short range, light damage, one in
        // the starting kit — find more in the dungeon. When thrown the
        // Ranged source steers the skill bonus toward RangedWeapons (per
        // weapon_skill_bonus) regardless of this tag; in melee bash it
        // counts as Short Blades.
        "Throwing Knife": (
            name: "Throwing Knife",
            tile_size: (32, 32),
            grid_size: (8, 8),
        kind: Weapon((
            damage: "1d4",
            weapon_range: 4,
            weapon_skill: Some(ShortBlades),
        )),
            rarity: Common,
            ascii_char: "{",
            ascii_fg: "#A0A0A0",
        ),
        // Ranger's starter bow. Shorter range than the standard Bow (6 vs 8),
