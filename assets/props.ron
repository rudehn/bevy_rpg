        "monster_trap": PropAsset(
            // Invisible step-trap that spawns monsters when an actor
            // walks onto its tile. RFC 0002 step 5 — used by the
            // Trapped Vault prefab, where it's colocated with a chest:
            // bumping opens the chest (chest wins via Collider
            // priority), and the trap fires on the next step into the
            // now-empty tile. OnceConsumed: trap despawns after firing.
            // ascii "^" matches the classic roguelike trap glyph.
            name: "Trap",
            is_blocking: false,
            is_opaque: false,
            grid_size: Some((1, 1)),
            tile_size: Some((16, 16)),
            ascii_char: "^",
