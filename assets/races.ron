// Race manifest for character creation. See docs/design/CHARACTER.md §Races.
//
// Keys must be the lowercase form of `Race` enum variant names so they can be
// resolved from a `Race` value at spawn. The passive trait associated with
// each race is encoded in the `Race::racial_trait()` method, not in this file —
// the asset stays pure data.
//
// id      | STR | DEX | CON | INT | trait        (in code)
// --------|-----|-----|-----|-----|----------------
// human   | +1  | +1  | +1  | +1  | Versatile
// dwarf   | +2  |  0  | +2  |  0  | Stoneblood (50% poison resistance)
// elf     |  0  | +2  |  0  | +2  | KeenSenses (+2 vision)
// halfling|  0  | +2  | +1  | +1  | Lucky (reroll any natural 1 on d20)

(
    races: {
        "human": (
            name: "Human",
            str_bonus: 1,
            dex_bonus: 1,
            con_bonus: 1,
            int_bonus: 1,
            description: "Versatile and adaptable. A bonus point ignores the per-stat allocation cap.",
        ),
        "dwarf": (
            name: "Dwarf",
            str_bonus: 2,
            dex_bonus: 0,
            con_bonus: 2,
            int_bonus: 0,
            description: "Hardy folk of the deep places. Stoneblood grants 50% poison resistance.",
        ),
        "elf": (
            name: "Elf",
            str_bonus: 0,
            dex_bonus: 2,
            con_bonus: 0,
            int_bonus: 2,
            description: "Long-sighted and quick. Keen senses extend your vision by 2 tiles.",
        ),
        "halfling": (
            name: "Halfling",
            str_bonus: 0,
            dex_bonus: 2,
            con_bonus: 1,
            int_bonus: 1,
            description: "Small, lucky, and impossible to corner. Any natural 1 on a d20 is rerolled.",
        ),
    },
)
